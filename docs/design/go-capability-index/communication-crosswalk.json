{
  "detectability_floor": [
    {
      "id": "GO-OTEL-5.2-HTTP-METRICS",
      "reason": "Metric emission lives in instrumentation call bodies; go_parser.py does not parse bodies, and the http import alone is already claimed by 5.1-HTTP.",
      "semconv_domain": "http",
      "tier": "advisory"
    },
    {
      "id": "GO-OTEL-5.7-CICD",
      "reason": "Evidenced by pipeline config + env vars (CI/GITHUB_ACTIONS), not a Go library import — nothing for an import-only detector to match.",
      "semconv_domain": "cicd",
      "tier": "advisory"
    }
  ],
  "detector": "import-only (advisory tier; no call graph)",
  "invariant": "15 §5 keys key-for-key identical to python-capability-index/communication-crosswalk.json",
  "pattern_ref": "dev-os/LANGUAGE-DOMAIN-COVERAGE-MAP.md",
  "patterns": [
    {
      "grounding": "corpus",
      "id": "GO-OTEL-5.1-HTTP",
      "import_signatures": [
        "net/http",
        "github.com/gin-gonic/gin",
        "github.com/gorilla/mux",
        "github.com/go-chi/chi",
        "github.com/labstack/echo"
      ],
      "otel_pattern": "HTTP",
      "semconv_domain": "http",
      "span_kinds": [
        "CLIENT",
        "SERVER"
      ]
    },
    {
      "floor": true,
      "id": "GO-OTEL-5.2-HTTP-METRICS",
      "note": "Metric emission (http.server.request.duration) lives in instrumentation call bodies; not distinguishable from plain HTTP by import. See detectability_floor.",
      "otel_pattern": "HTTP metrics",
      "semconv_domain": "http"
    },
    {
      "grounding": "corpus",
